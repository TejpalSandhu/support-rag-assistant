# Copy this file to .env and fill in your own keys. Never commit .env.

# Required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Langfuse tracing (https://cloud.langfuse.com -> Settings -> API Keys).
# Leave empty to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region (default). For the US region use https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Sign in with Google (leave GOOGLE_CLIENT_ID empty for local development:
# login is then off). Always set all three when the site is online.
#   GOOGLE_CLIENT_ID  Google Cloud Console > APIs & Services > Credentials
#   SESSION_SECRET    random, e.g. python -c "import secrets; print(secrets.token_hex(32))"
#   ALLOWED_EMAILS    who may use the app, comma-separated
GOOGLE_CLIENT_ID=
SESSION_SECRET=
ALLOWED_EMAILS=

# Optional: questions per person per day (default 20)
DAILY_QUESTION_LIMIT=

# Optional: answer model (free tier: about 20 answers per day per model).
# Switch here if a model is overloaded or its daily limit is used up.
GENERATION_MODEL=gemini-3.8-flash
# Asked automatically when the answer model is busy or out of quota
# (its own daily limit). "none" turns it off.
FALLBACK_MODEL=gemini-flash-lite-latest

# Optional: how close a passage must be before the model is asked (0-1).
# 0.631 suits the Prusa manuals; 0.55 is better for any PDF you upload.
MIN_SCORE=
